# Dependencies, build output, caches
node_modules/
dist/
build/
.next/
out/
coverage/
.turbo/
.cache/
.eslintcache
*.tsbuildinfo
*.local
*.tgz
.test-output/

# Secrets and local env. Examples stay tracked.
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
*.p12
*.pfx
.npmrc
credentials.json
